{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {},
  "formatter": true,
  "lsp": true,
  "mcp": {},
  "permissions": [
    { "action": "shell", "resource": "npm --workspace=* pack", "effect": "allow" },
    { "action": "shell", "resource": "npm --workspace=* run *", "effect": "allow" },
    { "action": "shell", "resource": "npm --workspace=* start", "effect": "allow" },
    { "action": "shell", "resource": "npm --workspace=* test", "effect": "allow" },
    { "action": "shell", "resource": "npm pack", "effect": "allow" },
    { "action": "shell", "resource": "npm run *", "effect": "allow" },
    { "action": "shell", "resource": "npm start", "effect": "allow" },
    { "action": "shell", "resource": "npm test", "effect": "allow" },
    { "action": "shell", "resource": "npx --workspace=* eslint *", "effect": "allow" },
    { "action": "shell", "resource": "npx --workspace=* playwright *", "effect": "allow" },
    { "action": "shell", "resource": "npx --workspace=* tsc *", "effect": "allow" },
    { "action": "shell", "resource": "npx --workspace=* vitest *", "effect": "allow" },
    { "action": "shell", "resource": "npx eslint *", "effect": "allow" },
    { "action": "shell", "resource": "npx playwright *", "effect": "allow" },
    { "action": "shell", "resource": "npx tsc *", "effect": "allow" },
    { "action": "shell", "resource": "npx vitest *", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
  ],
  "watcher": {
    "ignore": [
      "**/_site/**",
      "**/.cache/**",
      "**/.tests/**",
      "**/.wrangler/**",
      "**/node_modules/**",
      "**/dist/**",
    ],
  },
}
