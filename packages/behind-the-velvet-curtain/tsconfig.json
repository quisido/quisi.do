{
  "compilerOptions": {
    "composite": true,
    "declarationDir": "_site",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "outDir": "_site",
    "rootDir": ".",
    "sourceRoot": "src",
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
    "types": [
      "@types/node",
      "vite/client",
      "vite-plugin-pwa/client"
    ]
  },
  "extends": "quisido/tsconfig.json",
  "include": [
    "src/",
    "*.json",
    "*.ts"
  ],
  "references": [
    {
      "path": "../quisido/tsconfig.build.json"
    }
  ]
}
