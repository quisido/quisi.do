{
  "compilerOptions": {
    "declarationDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "sourceRoot": "src",
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo"
  },
  "exclude": [
    ".cache/",
    ".tests/",
    ".wrangler/",
    "dist/"
  ],
  "extends": "quisido/tsconfig.json",
  "include": [
    "**/*.json",
    "**/*.ts"
  ]
}
