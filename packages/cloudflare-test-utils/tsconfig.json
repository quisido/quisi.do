{
  "compilerOptions": {
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo"
  },
  "exclude": [
    ".cache/",
    ".tests/",
    "dist/",
    "node_modules/"
  ],
  "extends": "quisido/tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "references": [
    {
      "path": "../quisido/tsconfig.build.json"
    }
  ]
}
