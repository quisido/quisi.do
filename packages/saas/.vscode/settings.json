{
  "eslint.options": {
    "cache": true,
    "cacheLocation": "./.cache/"
  },
  "files.associations": {
    "hintrc.*.json": "jsonc"
  },
  "files.exclude": {
    "_site/": true,
    ".cache/": true,
    ".tests/": true,
    "graphify-out/": true,
    "node_modules/": true,
    "vitest.config.ts.timestamp-*-*.mjs": true
  },
  "files.watcherExclude": {
    "_site/": true,
    ".cache/": true,
    ".tests/": true,
    "graphify-out/": true,
    "lighthouse.report.html": true,
    "lighthouse.report.json": true,
    "lighthouse-0.devtoolslog.json": true,
    "lighthouse-0.trace.json": true,
    "node_modules/": true,
    "vitest.config.ts.timestamp-*-*.mjs": true
  },
  "scss.validate": false,
  "search.exclude": {
    "_site": true,
    ".cache/": true,
    ".tests/": true,
    "graphify-out/": true,
    "lighthouse.report.html": true,
    "lighthouse.report.json": true,
    "lighthouse-0.devtoolslog.json": true,
    "lighthouse-0.trace.json": true,
    "node_modules/": true,
    "vitest.config.ts.timestamp-*-*.mjs": true
  },
  "stylelint.validate": ["css", "scss"],
  "vitest.nodeExecArgs": ["--env-file", ".env.vitest-explorer"]
}
