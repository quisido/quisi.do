{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.json",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    ".vscode/",
    ".wrangler/",
    "_site/",
    "scripts/",
    "src/**/*.e2e.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/design-systems/core-test/",
    "src/*.test.ts",
    "src/*.test.tsx",
    "src/test/",
    ".*.json",
    "*.config.*",
    "lighthouse.*",
    "tsconfig.*"
  ],
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "rootDir": "src",
    "sourceMap": true,
    "sourceRoot": "https://github.com/quisido/quisi.do/raw/main/packages/saas/src/",
    "target": "es2023",
    "tsBuildInfoFile": ".cache/tsconfig.build.tsbuildinfo"
  },
  "references": [
    {
      "path": "../authn-shared/"
    },
    {
      "path": "../csp-shared/"
    },
    {
      "path": "../fmrs/"
    },
    {
      "path": "../fullstory-react/"
    },
    {
      "path": "../lazy-i18n/"
    },
    {
      "path": "../number-format-react/"
    },
    {
      "path": "../quisido/tsconfig.build.json"
    },
    {
      "path": "../react-datadog/"
    },
    {
      "path": "../sentry-react/"
    },
    {
      "path": "../use-force-update/"
    },
    {
      "path": "../use-shallow-memo/"
    }
  ]
}
