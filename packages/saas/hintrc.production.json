{
  // "$schema": "https://raw.githubusercontent.com/webhintio/hint/main/packages/hint/src/lib/config/config-schema.json",

  "extends": ["../../.hintrc"],

  "hints": {
    // Technical debt: Re-enable this when the theme is finalized.
    "axe/color": "off",
    "axe/keyboard": [
      "error",
      /** @see https://webhint.io/docs/user-guide/hints/hint-axe/keyboard/#additional-rules-off-by-default */
      {
        "accesskeys": "error",
        "focus-order-semantics": "error",
        "region": "error",
        "skip-link": "error",
        "tabindex": "error"
      }
    ],
    "axe/text-alternatives": "error",
    // Not supported for websites.
    "babel-config/is-valid": "off",
    /**
     * Technical debt: Re-enable this after debugging why the hint options in
     * `~/.hintrc` are ignored.
     */
    "compat-api/css": "off",
    // Technical debt: Re-enable these when the animation is optimized.
    "detect-css-reflows/composite": "off",
    "detect-css-reflows/paint": "off",
    "doctype": "error",
    /**
     * Technical debt: Could not get results from HTML checker for
     * 'https://quisi.do/'. Error: 'Unexpected token '<', "<!DOCTYPE "... is not
     * valid JSON'. (html-checker) at https://quisi.do/
     * "html-checker": ["error", { "details": true }],
     */
    "html-checker": "off",
    // "No valid configuration for Cloudinary found. Hint could not run."
    "image-optimization-cloudinary": "off",
    // Not supported for websites.
    "typescript-config/consistent-casing": "off",
    // Not supported for websites.
    "typescript-config/import-helpers": "off",
    // Not supported for websites.
    "typescript-config/strict": "off",
    // Not supported for websites.
    "typescript-config/target": "off",
    // Not supported for websites.
    "webpack-config/is-valid": "off",
    // Not supported for websites.
    "webpack-config/module-esnext-typescript": "off",
    // Not supported for websites.
    "webpack-config/modules-false-babel": "off",
    // Not supported for websites.
    "webpack-config/no-devtool-in-prod": "off"
  },

  "ignoredUrls": [
    {
      "domain": "^(?![\\d\\w]+.clarity.ms|analytics.google.com|browser-intake-datadoghq.com|cloudflareinsights.com|edge.fullstory.com|o592283.ingest.sentry.io|r.lgrckt-in.com|r.logr-ingest.com|r.lrkt-in.com|region1.analytics.google.com|rs.fullstory.com|stats.g.doubleclick.net|us.i.posthog.com|us-assets.i.posthog.com|www.google.ca|www.google.com.bd|www.google-analytics.com|www.googletagmanager.com$).*",
      "hints": [
        "content-type",
        "http-cache",
        "http-compression",
        "no-bom",
        "no-disallowed-headers",
        "no-html-only-headers",
        "no-http-redirects",
        "sri",
        "strict-transport-security",
        "validate-set-cookie-header",
        "x-content-type-options"
      ]
    }
  ]
}
