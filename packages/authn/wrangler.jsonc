{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-14",
  "dev": {
    "local_protocol": "https",
    "port": 5882, // parseInt('authn', 36) % 9999
  },
  "env": {
    "development": {
      "analytics_engine_datasets": [
        {
          "binding": "PRIVATE_DATASET",
          "dataset": "AUTHN_PRIVATE_DEV",
        },
      ],
      "d1_databases": [
        {
          "binding": "AUTHN_DB",
          "database_id": "AUTHN",
          "database_name": "authn-dev",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUDGET",
          "id": "BUDGET",
        },
      ],
      "name": "quisido-authn-dev",
      "r2_buckets": [
        {
          "binding": "AUTHN_DATA",
          "bucket_name": "authn-dev",
        },
      ],
      "secrets": {
        "required": [
          "JWT_ENCRYPTION_SECRET",
          "PATREON_OAUTH_CLIENT_SECRET",
        ],
      },
      "vars": {
        "COOKIE_DOMAIN": "localhost",
        "ENVIRONMENT_NAME": "development",
        "HOST": "localhost:3000",
        "JWT_AUDIENCE": "urn:quisi.do:saas:development",
        "JWT_ISSUER": "urn:quisi.do:authn:development",
        "PATREON_OAUTH_CLIENT_ID": "4kCae2AHZdKyyuonaPzhGillxJ2HyyLQEDu8StvMtixBHmWmN4KVG0QVP6R45tjG",
        "PATREON_OAUTH_HOST": "https://www.patreon.com",
        "PATREON_OAUTH_REDIRECT_URI": "https://localhost:5882/patreon/",
      },
    },
    "production": {
      "analytics_engine_datasets": [
        {
          "binding": "PRIVATE_DATASET",
          "dataset": "AUTHN_PRIVATE",
        },
      ],
      "d1_databases": [
        {
          "binding": "AUTHN_DB",
          "database_id": "d0e825fc-b58d-49b3-a86c-a9d967278d80",
          "database_name": "authn",
          "preview_database_id": "d546119e-036c-4c3d-a684-953418657a8d",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUDGET",
          "id": "428454de6b3d4d47be3fa82eda149d3d",
          "preview_id": "d5a8101e8daf49629fc1e0b64e6e0712",
        },
      ],
      "name": "quisido-authn",
      "r2_buckets": [
        {
          "binding": "AUTHN_DATA",
          "bucket_name": "authn",
        },
      ],
      "routes": [
        {
          "custom_domain": true,
          "pattern": "a.quisi.do",
        },
      ],
      "secrets": {
        "required": [
          "JWT_ENCRYPTION_SECRET",
          "PATREON_OAUTH_CLIENT_SECRET",
        ],
      },
      "vars": {
        "COOKIE_DOMAIN": "quisi.do",
        "ENVIRONMENT_NAME": "production",
        "HOST": "quisi.do",
        "JWT_AUDIENCE": "urn:quisi.do:saas:production",
        "JWT_ISSUER": "urn:quisi.do:authn:production",
        "PATREON_OAUTH_CLIENT_ID": "J_6jrNJZNibHylSF83UVl9I4OHZYf67RAsU0s7_LnH1N5BKF-vgOyweF3KQLOKm1",
        "PATREON_OAUTH_HOST": "https://www.patreon.com",
        "PATREON_OAUTH_REDIRECT_URI": "https://a.quisi.do/patreon/",
      },
    },
    "staging": {
      "analytics_engine_datasets": [
        {
          "binding": "PRIVATE_DATASET",
          "dataset": "AUTHN_PRIVATE_STAGING",
        },
        {
          "binding": "PUBLIC_DATASET",
          "dataset": "AUTHN_PUBLIC_STAGING",
        },
      ],
      "d1_databases": [
        {
          "binding": "AUTHN_DB",
          "database_id": "d546119e-036c-4c3d-a684-953418657a8d",
          "database_name": "authn-staging",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUDGET",
          "id": "d5a8101e8daf49629fc1e0b64e6e0712",
        },
      ],
      "name": "quisido-authn-staging",
      "r2_buckets": [
        {
          "binding": "AUTHN_DATA",
          "bucket_name": "authn-staging",
        },
      ],
      "routes": [
        {
          "custom_domain": true,
          "pattern": "staging.a.quisi.do",
        },
      ],
      "secrets": {
        "required": [
          "JWT_ENCRYPTION_SECRET",
          "PATREON_OAUTH_CLIENT_SECRET",
        ],
      },
      "vars": {
        "COOKIE_DOMAIN": "localhost",
        "ENVIRONMENT_NAME": "staging",
        "HOST": "localhost:3000",
        "JWT_AUDIENCE": "urn:quisi.do:saas:staging",
        "JWT_ISSUER": "urn:quisi.do:authn:staging",
        "PATREON_OAUTH_CLIENT_ID": "4kCae2AHZdKyyuonaPzhGillxJ2HyyLQEDu8StvMtixBHmWmN4KVG0QVP6R45tjG",
        "PATREON_OAUTH_HOST": "https://www.patreon.com",
        "PATREON_OAUTH_REDIRECT_URI": "https://localhost:5882/patreon/",
      },
      "workers_dev": true,
    },
    "test": {
      "compatibility_flags": ["nodejs_compat"],
      "secrets": {
        "required": [
          "JWT_ENCRYPTION_SECRET",
          "PATREON_OAUTH_CLIENT_SECRET",
        ],
      },
      "vars": {
        "COOKIE_DOMAIN": "cookie.domain",
        "ENVIRONMENT_NAME": "test",
        "HOST": "localhost:3000",
        "JWT_AUDIENCE": "urn:quisi.do:saas:test",
        "JWT_ISSUER": "urn:quisi.do:authn:test",
        "PATREON_OAUTH_CLIENT_ID": "4kCae2AHZdKyyuonaPzhGillxJ2HyyLQEDu8StvMtixBHmWmN4KVG0QVP6R45tjG",
        "PATREON_OAUTH_HOST": "https://www.patreon.com",
        "PATREON_OAUTH_REDIRECT_URI": "https://localhost:5882/patreon/",
      },
    },
  },
  "main": "src/index.ts",
  "name": "quisido-authn",
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
    },
  },
  "placement": {
    "mode": "smart",
  },
  "send_metrics": true,
  "tsconfig": "./tsconfig.json",
  "upload_source_maps": true,
  "vars": {
    "COOKIE_DOMAIN": "localhost",
    "ENVIRONMENT_NAME": "unknown",
    "HOST": "localhost:3000",
    "JWT_AUDIENCE": "urn:quisi.do:saas:development",
    "JWT_ISSUER": "urn:quisi.do:authn:development",
    "PATREON_OAUTH_CLIENT_ID": "4kCae2AHZdKyyuonaPzhGillxJ2HyyLQEDu8StvMtixBHmWmN4KVG0QVP6R45tjG",
    "PATREON_OAUTH_HOST": "https://www.patreon.com",
    "PATREON_OAUTH_REDIRECT_URI": "https://localhost:5882/patreon/",
  },
}

