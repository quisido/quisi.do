{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
  },
  "experimental": {
    "subagent_depth": 2,
  },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "servers": {
      "cloudflare": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
      },
    },
  },
  "permissions": [
    {
      "action": "*",
      "effect": "ask",
      "resource": "*",
    },
    // Edit
    {
      "action": "edit",
      "effect": "deny",
      "resource": "*",
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "~/.local/share/opencode/log/*",
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "/tmp/*",
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "src/*",
    },
    // External Directory
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "*",
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/opencode",
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.local/share/opencode/log",
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/tmp",
    },
    // Glob/Grep
    {
      "action": "glob",
      "effect": "allow",
      "resource": "*",
    },
    {
      "action": "grep",
      "effect": "allow",
      "resource": "*",
    },
    // Read
    {
      "action": "read",
      "effect": "deny",
      "resource": "*",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "lib/*",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "scripts/*",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "src/*",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "AGENTS.md",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "opencode.jsonc",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "package.json",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "README.md",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "tsconfig.json",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "worker-configuration.d.ts",
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "wrangler.jsonc",
    },
    // Shell
    {
      "action": "shell",
      "effect": "ask",
      "resource": "*",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "awk *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "cat *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "cp *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "cut *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "du *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "echo *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "fdfind *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "find *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "deny",
      "resource": "git *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git branch --show-current",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git config --get *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git diff *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git fetch *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git grep *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git log *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git ls-tree *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git pull *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git rm *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git show *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git stash *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git status *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "grep *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "head *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "ls *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "mkdir *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "mv *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npm install",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npm ls *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npm rebuild *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npm run fix",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npm test",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npx eslint src --fix",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npx tsc --skipLibCheck",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npx vitest run",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npx wrangler types",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "printf *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "pwd",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "rg *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "rm *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "rmdir *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "sed *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "shellcheck *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "sort *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "stat *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "deny",
      "resource": "sudo *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "tail *", // Technical debt: Restrict config/ and test/.
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "uniq *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "wc *",
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "which *",
    },
    // Skill/Subagent
    {
      "action": "skill",
      "effect": "allow",
      "resource": "*",
    },
    {
      "action": "subagent",
      "effect": "allow",
      "resource": "*",
    },
    // Web Fetch
    {
      "action": "webfetch",
      "effect": "ask",
      "resource": "*",
    },
    {
      "action": "webfetch",
      "effect": "allow",
      "resource": "opencode.ai",
    },
    // Web Search
    {
      "action": "websearch",
      "effect": "allow",
      "resource": "*",
    },
  ],
  "policies": [
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:sudo *",
    },
  ],
  "share": "disabled",
  "watcher": {
    "ignore": [
      ".wrangler/**",
      "coverage/**",
      "node_modules/**",
    ],
  },
}
