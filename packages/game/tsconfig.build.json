{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "rootDir": "src",
    "sourceMap": true,
    "sourceRoot": "https://github.com/quisido/quisi.do/raw/main/packages/game/src/",
    "target": "ES2022",
    "tsBuildInfoFile": ".cache/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/*.test.ts",
    "src/*.test.tsx"
  ],
  "extends": "./tsconfig.json",
  "include": [
    "src/"
  ],
  "references": [
    {
      "path": "../fmrs/tsconfig.build.json"
    }
  ]
}
