{
  "compilerOptions": {
    "declarationDir": "_site",
    "jsx": "react-jsxdev",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "_site",
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceRoot": "src",
    "types": [
      "@types/node"
    ]
  },
  "exclude": [
    ".cache/",
    ".tests/",
    "_site/",
    "node_modules/"
  ],
  "extends": "quisido/tsconfig.json",
  "include": [
    ".vscode/*.json",
    "src/",
    "types/",
    ".*.json",
    "*.json",
    "*.jsonc",
    "*.ts"
  ],
  "references": [
    {
      "path": "../fmrs/tsconfig.build.json"
    }
  ]
}
