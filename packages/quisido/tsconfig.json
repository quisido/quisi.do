{
  "compilerOptions": {
    "declarationDir": "dist",
    "outDir": "dist",
    "paths": {
      "eslint-plugin-sort-keys-custom-order": [
        "../../node_modules/eslint-plugin-sort-keys-custom-order/dist/src/index.d.ts",
        "./node_modules/eslint-plugin-sort-keys-custom-order/dist/src/index.d.ts"
      ]
    },
    "rootDir": ".",
    // `@vitest/browser` requires `"lib": ["DOM"]`.
    "skipLibCheck": true,
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo"
  },
  "extends": "./src/tsconfig.json",
  "include": [
    "src/",
    "*.json",
    "*.ts"
  ]
}
