{
  "compilerOptions": {
    "declarationDir": "dist",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "exclude": [
    ".cache/",
    ".git/",
    ".idea/",
    ".tests/",
    ".wrangler/",
    "dist/",
    "node_modules/",
    "packages/"
  ],
  "extends": "quisido/tsconfig.json",
  "include": [
    "**/.*/**/*.ts",
    "**/.*/**/.*.json",
    "**/.*/**/*.json",
    "**/.*.json",
    "**/*.json",
    "**/*.ts"
  ],
  "references": [
    {
      "path": "./packages/fmrs/tsconfig.build.json"
    },
    {
      "path": "./packages/quisido/tsconfig.build.json"
    }
  ]
}
