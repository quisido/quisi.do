  "settings": {
    "files.associations": {
      "**/.aiexclude": "ignore",
      "**/.vscode/settings.json": "jsonc",
      "**/*.code-workspace": "jsonc",
      "**/config/api-extractor.json": "jsonc",
      "**/hintrc.*.json": "jsonc",
    },
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    /**
    * This value is normally `./node_modules/typescript/lib`, but the TypeScript
    * library is located at `@typescript/old` as long as `typescript` is
    * installed as a shim (`npm:@typescript/typescript6@^6`). It is currently a
    * shim until TypeScript 7.1 adds support for ESLint.
    */
    "js/ts.tsdk.path": "./node_modules/@typescript/old/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "remote.portsAttributes": {
